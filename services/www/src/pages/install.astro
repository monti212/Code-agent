---
export const prerender = false

// U Code has no published release yet, so there is nothing to download. Answer `curl … | sh` with a script that
// explains how to install from source and exits non-zero, rather than proxying another project's installer.
const script = `#!/bin/sh
cat >&2 <<'MSG'
U Code is not published as a downloadable release yet.

Install it from source with Bun (https://bun.sh):

  git clone https://github.com/monti212/Code-agent
  cd Code-agent
  bun install
  bun run dev

Docs: https://code.uhuruai.co/docs
MSG
exit 1
`

return new Response(script, {
  headers: { "Content-Type": "text/x-shellscript; charset=utf-8", "Cache-Control": "no-store" },
})
---
